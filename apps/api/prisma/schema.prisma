generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  accounts      Account[]
  invitations   Invitation[] @relation("InvitationInviter")
  memberships   Membership[]
  sessions      Session[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime
}

model Organization {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  logo            String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assets          Asset[]
  CompanyBrain    CompanyBrain?
  contextArtifact ContextArtifact?
  contextSources  ContextSource[]
  designSystem    DesignSystemProfile?
  invitations     Invitation[]
  memberships     Membership[]
  onboardingDraft OnboardingDraft?
  roles           Role[]
}

model Role {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  membershipRoles MembershipRole[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]

  @@unique([organizationId, name])
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  key    String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
}

model Membership {
  id             String                         @id @default(cuid())
  userId         String
  organizationId String
  active         Boolean                        @default(true)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides      MembershipPermissionOverride[]
  roles          MembershipRole[]

  @@unique([userId, organizationId])
}

model MembershipRole {
  id           String     @id @default(cuid())
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model MembershipPermissionOverride {
  id           String     @id @default(cuid())
  membershipId String
  key          String
  effect       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, key])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  inviterId      String
  organizationId String
  roleId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OnboardingDraft {
  id             String       @id @default(cuid())
  organizationId String       @unique
  currentStep    Int          @default(0)
  data           Json         @default("{}")
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ContextSource {
  id                String       @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  sourceKind        String
  sourceUrl         String?
  fileName          String?
  mimeType          String?
  fileSize          Int?
  objectKey         String?
  publicUrl         String?
  pipelineStatus    String       @default("pending")
  pipelineError     String?
  extractedContent  String?
  normalizedContent String?
  reviewNotes       String?
  reviewedAt        DateTime?
  reviewedById      String?
  tags              String[]     @default([])
  category          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@index([organizationId, pipelineStatus])
}

model ContextArtifact {
  id             String       @id @default(cuid())
  organizationId String       @unique
  objectKey      String?
  publicUrl      String?
  syncStatus     String       @default("idle")
  syncedAt       DateTime?
  syncError      String?
  sourceCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Asset {
  id                String          @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  sourceKind        String
  sourceUrl         String?
  fileName          String?
  mimeType          String?
  visibleType       String?
  visibleCategory   String?
  tags              String[]        @default([])
  contextRole       Boolean         @default(false)
  operationalRole   Boolean         @default(true)
  contextStatus     String?
  operationalStatus String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relations         AssetRelation[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, contextRole])
  @@index([organizationId, operationalRole])
}

model AssetRelation {
  id      String @id @default(cuid())
  assetId String
  kind    String
  value   String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model DesignSystemProfile {
  id                        String             @id @default(cuid())
  organizationId            String             @unique
  brandEssence              String?
  desiredPerception         String?
  visualStyle               String?
  antiPatterns              String?
  conceptualReferences      String?
  aiNotes                   String?
  artifactSyncStatus        String             @default("idle")
  artifactSyncedAt          DateTime?
  artifactSyncError         String?
  artifactObjectKey         String?
  contextArtifactSyncStatus String             @default("idle")
  contextArtifactSyncedAt   DateTime?
  contextArtifactSyncError  String?
  contextArtifactObjectKey  String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  assets                    DesignAsset[]
  colorGroups               DesignColorGroup[]
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, artifactSyncStatus])
}

model DesignColorGroup {
  id             String              @id @default(cuid())
  designSystemId String
  name           String
  description    String?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  designSystem   DesignSystemProfile @relation(fields: [designSystemId], references: [id], onDelete: Cascade)
  colors         DesignColorToken[]

  @@unique([designSystemId, name])
  @@index([designSystemId, sortOrder])
}

model DesignColorToken {
  id              String           @id @default(cuid())
  colorGroupId    String
  name            String
  value           String
  displayFormat   String           @default("hex")
  semanticRole    String
  usageNote       String?
  restrictionNote String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  colorGroup      DesignColorGroup @relation(fields: [colorGroupId], references: [id], onDelete: Cascade)

  @@unique([colorGroupId, name])
  @@index([colorGroupId, sortOrder])
}

model DesignAsset {
  id             String              @id @default(cuid())
  designSystemId String
  organizationId String
  primaryRole    String
  secondaryTags  String[]            @default([])
  title          String?
  description    String?
  objectKey      String
  publicUrl      String?
  fileName       String
  contentType    String
  size           Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  designSystem   DesignSystemProfile @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@index([designSystemId, primaryRole])
}

model PlatformRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  role       String
  assignedBy String
  assignedAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
}

model SupportSession {
  id             String    @id @default(cuid())
  actorUserId    String
  organizationId String
  reason         String
  status         String    @default("active")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([actorUserId])
  @@index([organizationId])
  @@index([status])
}

model AuditLog {
  id                   String   @id @default(cuid())
  actorUserId          String
  targetOrganizationId String?
  targetUserId         String?
  action               String
  resourceType         String
  resourceId           String
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())

  @@index([actorUserId])
  @@index([targetOrganizationId])
  @@index([action])
  @@index([createdAt])
}

model AIProvider {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  description        String?
  status             String             @default("draft")
  iconMetadata       Json               @default("{}")
  capabilityMetadata Json               @default("{}")
  pricingMetadata    Json               @default("{}")
  limitsMetadata     Json               @default("{}")
  schemaMetadata     Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  credentials        AICredential[]
  models             AIModel[]
  policies           AIProviderPolicy[]

  @@index([status])
}

model AIModel {
  id                 String     @id @default(cuid())
  providerId         String
  slug               String
  name               String
  description        String?
  externalModelId    String
  status             String     @default("draft")
  capabilityMetadata Json       @default("{}")
  pricingMetadata    Json       @default("{}")
  limitsMetadata     Json       @default("{}")
  schemaMetadata     Json       @default("{}")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  provider           AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, slug])
  @@unique([providerId, externalModelId])
  @@index([providerId, status])
}

model AICredential {
  id              String     @id @default(cuid())
  providerId      String
  organizationId  String?
  label           String
  value           String
  schemaMetadata  Json       @default("{}")
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([organizationId])
}

model AIProviderPolicy {
  id              String     @id @default(cuid())
  providerId      String
  organizationId  String
  allowedModelIds String[]   @default([])
  metadata        Json       @default("{}")
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId])
  @@index([organizationId])
}

model AgentTemplate {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  description         String?
  category            String
  status              String         @default("draft")
  allowedBlocks       String[]       @default([])
  defaultFlow         Json           @default("{}")
  defaultInputSchema  Json           @default("{}")
  defaultOutputSchema Json           @default("{}")
  executionProfile    Json           @default("{}")
  modelPolicy         Json           @default("{}")
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  agents              CompanyAgent[]

  @@index([status, updatedAt])
}

model CompanyAgent {
  id              String               @id @default(cuid())
  organizationId  String
  templateId      String?
  slug            String
  name            String
  description     String?
  status          String               @default("draft")
  allowedTools    Json                 @default("[]")
  activeVersionId       String?
  onboardingCompletedAt DateTime?
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  chatThreads     AgentChatThread[]
  chatToolCalls   AgentChatToolCall[]
  contextProfile  AgentContextProfile?
  runs            AgentRun[]
  versions        AgentVersion[]
  template        AgentTemplate?       @relation(fields: [templateId], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
}

model AgentVersion {
  id                String       @id @default(cuid())
  agentId           String
  versionNumber     Int
  status            String       @default("draft")
  flowDefinition    Json         @default("{}")
  inputSchema       Json         @default("{}")
  outputSchema      Json         @default("{}")
  notes             String?
  createdByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  runs              AgentRun[]
  companyAgent      CompanyAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, versionNumber])
  @@index([agentId, status, updatedAt])
}

model AgentRun {
  id                   String                     @id @default(cuid())
  organizationId       String
  agentId              String
  agentVersionId       String
  status               String                     @default("queued")
  inputPayload         Json                       @default("{}")
  outputPayload        Json?
  errorMessage         String?
  createdByUserId      String
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  attemptCount         Int                        @default(0)
  completedAt          DateTime?
  lastAttemptAt        DateTime?
  leaseExpiresAt       DateTime?
  processingLeaseId    String?
  processingMetadata   Json                       @default("{}")
  queuePosition        Int?
  sourceMessageId      String?
  startedAt            DateTime?
  threadId             String?
  rootRunId            String?
  parentRunId          String?
  parentStepId         String?
  depth                Int                        @default(0)
  currentBlockId       String?
  currentBlockType     String?
  waitingReason        String?
  resumeStatus         String?
  chunkIdsRetrieved    String[]                   @default([])
  durationMs           Int?
  intentClassified     String?
  sourcesSelected      String[]                   @default([])
  tokensUsed           Int?
  chatMessages         AgentChatMessage[]
  agent                CompanyAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion         AgentVersion               @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  parentRun            AgentRun?                  @relation("AgentRunParentLineage", fields: [parentRunId], references: [id])
  childRuns            AgentRun[]                 @relation("AgentRunParentLineage")
  parentStep           AgentRunStep?              @relation("AgentRunParentStep", fields: [parentStepId], references: [id])
  rootRun              AgentRun?                  @relation("AgentRunRootLineage", fields: [rootRunId], references: [id])
  rootChildRuns        AgentRun[]                 @relation("AgentRunRootLineage")
  sourceMessage        AgentChatMessage?          @relation("AgentRunSourceMessage", fields: [sourceMessageId], references: [id])
  thread               AgentChatThread?           @relation(fields: [threadId], references: [id])
  contextSnapshot      AgentRunContextSnapshot?
  steps                AgentRunStep[]
  suspensions          AgentRunSuspension[]
  creditEntries        CreditLedgerEntry[]
  technicalCostEntries TechnicalCostLedgerEntry[]

  @@index([organizationId, status, createdAt])
  @@index([agentId, createdAt])
  @@index([processingLeaseId])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, threadId])
  @@index([organizationId, createdByUserId, createdAt])
  @@index([rootRunId])
  @@index([parentRunId])
  @@index([parentStepId])
}

model AgentRunStep {
  id              String               @id @default(cuid())
  runId           String
  blockKey        String
  blockType       String
  status          String
  inputPayload    Json                 @default("{}")
  outputPayload   Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  metadata        Json                 @default("{}")
  sequence        Int?
  branchKey       String?
  inputType       String?
  outputType      String?
  statePayload    Json?
  uiOutputPayload Json?
  childAgentRuns  AgentRun[]           @relation("AgentRunParentStep")
  run             AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  suspensions     AgentRunSuspension[]

  @@index([runId, createdAt])
  @@index([runId, sequence])
}

model AgentContextProfile {
  id           String                  @id @default(cuid())
  agentId      String                  @unique
  instructions String?
  notes        String?
  metadata     Json                    @default("{}")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  files        AgentContextFile[]
  agent        CompanyAgent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  references   AgentContextReference[]
}

model AgentContextFile {
  id        String              @id @default(cuid())
  profileId String
  filename  String
  objectKey String
  mimeType  String
  sizeBytes Int
  publicUrl String?
  status    String              @default("active")
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  profile   AgentContextProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, status])
}

model AgentContextReference {
  id         String              @id @default(cuid())
  profileId  String
  sourceType String
  sourceId   String
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  profile    AgentContextProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, sourceType, sourceId])
  @@index([profileId])
}

model AgentRunContextSnapshot {
  id              String                        @id @default(cuid())
  runId           String                        @unique
  layers          Json                          @default("{}")
  resolvedSummary String?
  metadata        Json                          @default("{}")
  createdAt       DateTime                      @default(now())
  run             AgentRun                      @relation(fields: [runId], references: [id], onDelete: Cascade)
  items           AgentRunContextSnapshotItem[]
}

model AgentRunContextSnapshotItem {
  id         String                  @id @default(cuid())
  snapshotId String
  sourceType String
  sourceId   String?
  label      String
  content    String?
  summary    String?
  metadata   Json                    @default("{}")
  createdAt  DateTime                @default(now())
  snapshot   AgentRunContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([sourceType, sourceId])
}

model AgentRunSuspension {
  id              String                       @id @default(cuid())
  runId           String
  stepId          String?
  type            String
  status          String                       @default("pending")
  resolvedPayload Json                         @default("{}")
  roundNumber     Int                          @default(1)
  metadata        Json                         @default("{}")
  answeredAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  run             AgentRun                     @relation(fields: [runId], references: [id], onDelete: Cascade)
  step            AgentRunStep?                @relation(fields: [stepId], references: [id])
  responses       AgentRunSuspensionResponse[]

  @@index([runId, status])
  @@index([stepId])
}

model AgentRunSuspensionResponse {
  id           String             @id @default(cuid())
  suspensionId String
  answers      Json               @default("{}")
  roundNumber  Int                @default(1)
  metadata     Json               @default("{}")
  answeredById String
  answeredAt   DateTime           @default(now())
  suspension   AgentRunSuspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)

  @@index([suspensionId])
  @@index([answeredById])
}

model AgentChatThread {
  id                    String             @id @default(cuid())
  organizationId        String
  agentId               String?
  scope                 String
  title                 String?
  parentThreadId        String?
  branchedFromMessageId String?
  createdByUserId       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  messages              AgentChatMessage[]
  toolCalls             AgentChatToolCall[]
  agent                 CompanyAgent?      @relation(fields: [agentId], references: [id])
  branchedFromMessage   AgentChatMessage?  @relation("AgentChatThreadBranchMessage", fields: [branchedFromMessageId], references: [id])
  parentThread          AgentChatThread?   @relation("AgentChatThreadBranches", fields: [parentThreadId], references: [id])
  branches              AgentChatThread[]  @relation("AgentChatThreadBranches")
  runs                  AgentRun[]

  @@index([organizationId, scope, updatedAt])
  @@index([agentId, updatedAt])
}

model AgentChatMessage {
  id                       String             @id @default(cuid())
  threadId                 String
  agentRunId               String?
  role                     String
  content                  String
  metadata                 Json               @default("{}")
  editedFromMessageId      String?
  regeneratedFromMessageId String?
  createdByUserId          String?
  createdAt                DateTime           @default(now())
  agentRun                 AgentRun?          @relation(fields: [agentRunId], references: [id])
  editedFromMessage        AgentChatMessage?  @relation("AgentChatMessageEdits", fields: [editedFromMessageId], references: [id])
  editedVariants           AgentChatMessage[] @relation("AgentChatMessageEdits")
  regeneratedFromMessage   AgentChatMessage?  @relation("AgentChatMessageRegenerations", fields: [regeneratedFromMessageId], references: [id])
  regenerations            AgentChatMessage[] @relation("AgentChatMessageRegenerations")
  thread                   AgentChatThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  branches                 AgentChatThread[]  @relation("AgentChatThreadBranchMessage")
  sourceRuns               AgentRun[]         @relation("AgentRunSourceMessage")
  toolCalls                AgentChatToolCall[]

  @@index([threadId, createdAt])
  @@index([agentRunId])
}

model AgentChatToolCall {
  id              String           @id @default(cuid())
  organizationId  String
  agentId         String
  threadId        String
  messageId       String
  toolName        String
  status          String
  inputPayload    Json
  outputPayload   Json?
  errorMessage    String?
  durationMs      Int?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  agent           CompanyAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread          AgentChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message         AgentChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, createdAt])
  @@index([threadId, createdAt])
  @@index([messageId])
}

model CreditLedgerEntry {
  id              String    @id @default(cuid())
  organizationId  String
  runId           String?
  entryType       String
  amount          Int
  balanceAfter    Int
  metadata        Json      @default("{}")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  idempotencyKey  String?   @unique
  run             AgentRun? @relation(fields: [runId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entryType])
}

model TechnicalCostLedgerEntry {
  id             String    @id @default(cuid())
  organizationId String?
  runId          String?
  providerId     String?
  modelId        String?
  amount         Float
  currency       String    @default("USD")
  unit           String    @default("estimated")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  idempotencyKey String?   @unique
  run            AgentRun? @relation(fields: [runId], references: [id])

  @@index([createdAt])
  @@index([providerId, createdAt])
  @@index([modelId, createdAt])
}

model RagDocument {
  id             String        @id @default(cuid())
  organizationId String
  sourceType     String
  sourceId       String?
  title          String?
  contentHash    String?
  status         String        @default("pending")
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  chunks         RagChunk[]
  indexJobs      RagIndexJob[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status])
  @@index([organizationId, sourceType])
}

model RagChunk {
  id         String        @id @default(cuid())
  documentId String
  sequence   Int
  content    String
  tokenCount Int?
  metadata   Json          @default("{}")
  createdAt  DateTime      @default(now())
  document   RagDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding  RagEmbedding?

  @@index([documentId, sequence])
}

model RagEmbedding {
  id             String                 @id @default(cuid())
  chunkId        String                 @unique
  organizationId String
  model          String
  dimensions     Int
  vector         Unsupported("vector")?
  createdAt      DateTime               @default(now())
  chunk          RagChunk               @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model RagIndexJob {
  id                String      @id @default(cuid())
  organizationId    String
  documentId        String
  status            String      @default("queued")
  errorMessage      String?
  triggeredByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  document          RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([documentId, createdAt])
}

model BrainVersion {
  id                String       @id
  brainId           String
  versionNumber     Int
  status            String       @default("draft")
  data              Json         @default("{}")
  notes             String?
  createdByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  CompanyBrain      CompanyBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  @@unique([brainId, versionNumber])
  @@index([brainId, status, updatedAt])
}

model CompanyBrain {
  id              String         @id
  organizationId  String         @unique
  activeVersionId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  BrainVersion    BrainVersion[]
  Organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
