generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (managed by better-auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  invitations Invitation[] @relation("InvitationInviter")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime
}

// ---------------------------------------------------------------------------
// Organizations domain (app-owned)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  roles           Role[]
  invitations     Invitation[]
  onboardingDraft OnboardingDraft?
  assets          Asset[]
  designSystem    DesignSystemProfile?
  contextSources  ContextSource[]
  contextArtifact ContextArtifact?
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([organizationId, name])
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  key    String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  overrides    MembershipPermissionOverride[]

  @@unique([userId, organizationId])
}

model MembershipRole {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model MembershipPermissionOverride {
  id           String @id @default(cuid())
  membershipId String
  key          String
  effect       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, key])
}

model Invitation {
  id             String   @id @default(cuid())
  email          String
  inviterId      String
  organizationId String
  roleId         String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Onboarding domain
// ---------------------------------------------------------------------------

model OnboardingDraft {
  id             String    @id @default(cuid())
  organizationId String    @unique
  currentStep    Int       @default(0)
  data           Json      @default("{}")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Context domain
// ---------------------------------------------------------------------------

model ContextSource {
  id                String    @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  sourceKind        String
  sourceUrl         String?
  fileName          String?
  mimeType          String?
  fileSize          Int?
  objectKey         String?
  publicUrl         String?
  pipelineStatus    String    @default("pending")
  pipelineError     String?
  extractedContent  String?
  normalizedContent String?
  reviewNotes       String?
  reviewedAt        DateTime?
  reviewedById      String?
  tags              String[]  @default([])
  category          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@index([organizationId, pipelineStatus])
}

model ContextArtifact {
  id             String    @id @default(cuid())
  organizationId String    @unique
  objectKey      String?
  publicUrl      String?
  syncStatus     String    @default("idle")
  syncedAt       DateTime?
  syncError      String?
  sourceCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Assets and company context domain (legacy - mantido para compatibilidade)
// ---------------------------------------------------------------------------

model Asset {
  id                String   @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  sourceKind        String
  sourceUrl         String?
  fileName          String?
  mimeType          String?
  visibleType       String?
  visibleCategory   String?
  tags              String[] @default([])
  contextRole       Boolean  @default(false)
  operationalRole   Boolean  @default(true)
  contextStatus     String?
  operationalStatus String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relations    AssetRelation[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, contextRole])
  @@index([organizationId, operationalRole])
}

model AssetRelation {
  id      String @id @default(cuid())
  assetId String
  kind    String
  value   String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Company design system domain
// ---------------------------------------------------------------------------

model DesignSystemProfile {
  id                        String    @id @default(cuid())
  organizationId            String    @unique
  brandEssence              String?
  desiredPerception         String?
  visualStyle               String?
  antiPatterns              String?
  conceptualReferences      String?
  aiNotes                   String?
  artifactSyncStatus        String    @default("idle")
  artifactSyncedAt          DateTime?
  artifactSyncError         String?
  artifactObjectKey         String?
  contextArtifactSyncStatus String    @default("idle")
  contextArtifactSyncedAt   DateTime?
  contextArtifactSyncError  String?
  contextArtifactObjectKey  String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  colorGroups  DesignColorGroup[]
  assets       DesignAsset[]

  @@index([organizationId, artifactSyncStatus])
}

model DesignColorGroup {
  id             String   @id @default(cuid())
  designSystemId String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  designSystem DesignSystemProfile @relation(fields: [designSystemId], references: [id], onDelete: Cascade)
  colors       DesignColorToken[]

  @@unique([designSystemId, name])
  @@index([designSystemId, sortOrder])
}

model DesignColorToken {
  id              String   @id @default(cuid())
  colorGroupId    String
  name            String
  value           String
  displayFormat   String   @default("hex")
  semanticRole    String
  usageNote       String?
  restrictionNote String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  colorGroup DesignColorGroup @relation(fields: [colorGroupId], references: [id], onDelete: Cascade)

  @@unique([colorGroupId, name])
  @@index([colorGroupId, sortOrder])
}

model DesignAsset {
  id             String   @id @default(cuid())
  designSystemId String
  organizationId String
  primaryRole    String
  secondaryTags  String[] @default([])
  title          String?
  description    String?
  objectKey      String
  publicUrl      String?
  fileName       String
  contentType    String
  size           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  designSystem DesignSystemProfile @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@index([designSystemId, primaryRole])
}
