{
  "name": "@company-os/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm start:dev",
    "build": "prisma generate && nest build",
    "format": "biome check --write src test package.json tsconfig.json tsconfig.build.json nest-cli.json prisma/schema.prisma",
    "start": "nest start",
    "start:dev": "pnpm --filter @company-os/authz build && pnpm --filter @company-os/types build && pnpm --filter @company-os/agent-ia-sdk build && pnpm prisma:generate && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "biome check src test package.json tsconfig.json tsconfig.build.json nest-cli.json prisma/schema.prisma",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --testPathPattern=integration --config ./test/jest-e2e.json",
    "test:e2e": "AGENT_EXECUTION_MODE=trigger jest --config ./test/jest-e2e.json",
    "test:live": "AGENT_EXECUTION_MODE=trigger jest --testPathPattern=live --config ./test/jest-e2e.json",
    "carousel:previews": "pnpm exec tsx scripts/render-template-previews.ts",
    "carousel:validate-previews": "pnpm exec tsx scripts/validate-template-previews.ts",
    "carousel:validate-shell": "pnpm exec tsx scripts/validate-template-shell.ts",
    "carousel:validate-all": "pnpm exec tsx scripts/validate-all-template-variations.ts",
    "carousel:validate-visual": "pnpm exec tsx scripts/validate-visual-all.ts",
    "carousel:gallery": "pnpm exec tsx scripts/serve-template-gallery.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "generate:style-previews": "ts-node -r tsconfig-paths/register prisma/scripts/generate-style-previews.ts",
    "db:reset-folders": "ts-node -r tsconfig-paths/register prisma/scripts/reset-workspace-folders.ts",
    "storage:sync": "ts-node -r tsconfig-paths/register prisma/scripts/sync-storage.ts",
    "postinstall": "node scripts/ensure-ffmpeg-static.cjs && node scripts/ensure-puppeteer-chrome.cjs"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/lib-storage": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@better-auth/prisma-adapter": "^1.6.11",
    "@better-auth/utils": "^0.4.0",
    "@company-os/agent-ia-sdk": "workspace:^",
    "@company-os/authz": "workspace:^",
    "@company-os/db": "workspace:^",
    "@company-os/types": "workspace:^",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.20",
    "@nestjs/websockets": "^11.1.20",
    "@openrouter/agent": "0.7.0",
    "@openrouter/sdk": "0.12.35",
    "@prisma/client": "^6.16.3",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@trigger.dev/sdk": "4.5.0",
    "better-auth": "^1.6.11",
    "cookie-parser": "^1.4.7",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "remotion": "^4.0.0",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@trigger.dev/build": "4.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.0.0",
    "import-in-the-middle": "^3.2.0",
    "jest": "^30.0.0",
    "prisma": "^6.16.3",
    "require-in-the-middle": "^8.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}