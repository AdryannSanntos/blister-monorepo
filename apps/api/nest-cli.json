{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "agents/**/skills/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "video/compositions/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "agents/carousel/templates/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
