# ── Runtime (dev local) ───────────────────────────────────
NODE_ENV=development
# Internal URL for Trigger.dev workers → POST /api/internal/agent-runs (must be the API, not the web app)
APP_URL=http://localhost:3001

# ── Postgres ──────────────────────────────────────────────
POSTGRES_DB=blister_db
POSTGRES_USER=blister_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DATABASE_URL=postgresql://blister_user:change-me@localhost:5432/blister_db?schema=public
PORT=3001
API_BASE_URL=http://localhost:3001

# ── Auth & CORS ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001

# Production (EasyPanel — single domain blister.adryansantoss.dev)
# CORS_ORIGIN=https://blister.adryansantoss.dev
# BETTER_AUTH_URL=https://blister.adryansantoss.dev
# APP_URL=https://blister.adryansantoss.dev
# NEXT_PUBLIC_API_URL=https://blister.adryansantoss.dev
# OPENROUTER_HTTP_REFERER=https://blister.adryansantoss.dev

# ── Frontend (build + runtime do web) ─────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_INTERNAL_API_URL=http://api:3001

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=Blister <noreply@example.com>

# ── Google OAuth (opcional) ───────────────────────────────
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# ── Storage S3 (opcional) ─────────────────────────────────
AWS_REGION=sfo3
AWS_S3_BUCKET=workana-ai-bucket
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
AWS_S3_FORCE_PATH_STYLE=true

# ── Agentes / IA (opcional) ───────────────────────────────
# Trigger worker (dev): cd apps/api && npx trigger.dev@latest dev
# Use TRIGGER_SECRET_KEY tr_dev_... (não tr_prod_) em dev local
# Node 25+: NODE_OPTIONS=--no-experimental-webstorage (ver apps/api/.env)
AGENT_EXECUTION_MODE=trigger
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Blister
OPENROUTER_TIMEOUT_MS=60000

ASSEMBLYAI_API_KEY=change-me
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_STREAMING_BASE_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_LLM_GATEWAY_BASE_URL=https://llm-gateway.assemblyai.com/v1

GEMINI_API_KEY=change-me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

TRIGGER_SECRET_KEY=change-me
TRIGGER_PROJECT_ID=change-me
